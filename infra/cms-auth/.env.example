# GitHub → Settings → Developer settings → OAuth Apps 에서 만든 앱의 값
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 로그인 결과를 받을 수 있는 관리 화면 주소 (쉼표로 여러 개)
ALLOWED_ORIGINS=https://onjungwriter.github.io

# nginx 공개 주소. GitHub OAuth App 의 callback URL 은 이 주소 + /callback
PUBLIC_URL=https://jhong.n-e.kr/onjung-auth
